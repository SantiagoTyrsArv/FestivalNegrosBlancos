# ==============================================================================
# Carnaval de Blancos y Negros — variables de entorno (todas opcionales)
# Copia este archivo como .env.local si quieres cambiar algún valor.
# No hay base de datos: todos los datos están quemados en src/datos/catalogo.ts.
# ==============================================================================

# 1 = muestra el RenderBadge flotante en todas las páginas (también con ?debug=1).
DEBUG_RENDERING=0

# URL pública del sitio (metadatos, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto para firmar la cookie de sesión. Si no se define, se genera uno
# aleatorio al arrancar (las sesiones se cierran al reiniciar el servidor).
# SESSION_SECRET=
