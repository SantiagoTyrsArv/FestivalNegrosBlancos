# ==============================================================================
# Carnaval de Blancos y Negros — variables de entorno
# Copia este archivo como .env.local. Todas se validan con Zod al arrancar
# (src/shared/config/env.ts): si falta una o es inválida, el servidor no inicia.
# ==============================================================================

# Base de datos en Turso (libSQL). Crea la BD y el token con la CLI de Turso:
#   turso db create carnaval
#   turso db show carnaval --url        -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create carnaval     -> TURSO_AUTH_TOKEN
# Luego: pnpm db:setup (aplica migraciones y seed en la nube).
# Para trabajar sin red puedes usar un archivo local: TURSO_DATABASE_URL=file:local.db (sin token).
TURSO_DATABASE_URL=libsql://carnaval-tu-usuario.turso.io
TURSO_AUTH_TOKEN=pega-aqui-el-token-de-turso

# Clave para firmar la cookie de sesión (HS256). Mínimo 32 caracteres.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-caracteres-o-mas

# Secreto que exige POST /api/revalidate (cabecera Authorization: Bearer <secreto>).
# Mínimo 16 caracteres.
REVALIDATION_SECRET=cambia-este-secreto-de-revalidacion

# 1 = muestra el RenderBadge flotante en todas las páginas (también con ?debug=1).
DEBUG_RENDERING=0

# 1 = el Observatorio es visible sin sesión de admin en producción (útil en una demo).
# En desarrollo siempre es visible. El Modo Caos exige rol admin siempre.
OBSERVATORIO_PUBLICO=0

# URL pública del sitio (metadatos, sitemap, Open Graph). Es pública: nunca pongas secretos en NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
